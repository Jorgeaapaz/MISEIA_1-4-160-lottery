# ============================================================
# .env.example — copy to .env.local and fill in real values
# cp .env.example .env.local
# ============================================================

# ── MongoDB ──────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Production GCI VM: mongodb://admin:<password>@34.174.56.186:27020/?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lottery_db

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-min-32-chars

# ── Stripe ───────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys (test keys start with pk_test_ / sk_test_)
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_replace_me

# ── Email (Nodemailer) ───────────────────────────────────────
# Development: use MailHog (localhost:1025 SMTP, localhost:8025 UI)
# Production: use MailHog at mailhog.deviaaps.com or real SMTP
MAILHOG_HOST=localhost
MAIL_PORT=1027

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── AWS / RustFS S3-compatible (optional) ────────────────────
# Only required if using file storage features
AWS_USERNAME=minioadmin
AWS_PASSWORD=replace_me
AWS_REGION=us-east-1
AWS_URL=http://localhost:10000
AWS_BUCKET=lottery-bucket
